# Copy to .env (optional - these are the defaults).
SMC_PORT=8080                  # dashboard + API on http://localhost:8080
SMC_IMAGE=space-ml-mission-control:3.1.9   # set to a published image (e.g. ghcr.io/<you>/space-ml-mission-control:3.1.9) to skip the build
SPACEML_AUTOSETUP=off          # off (default): nothing downloads or trains by itself | light | full (opt-in background setup)
SPACEML_TRAIN_CPUS=            # CPUs one training job may use (default: all but one)
SPACEML_HEAVY_JOBS=1           # training jobs at the same time
SPACEML_JOB_STALL_MINUTES=30   # stop a background job that shows no progress for this long (it can be retried)
SPACEML_MARS_WEIGHTS_URL=      # optional: https link to a mars_model.zip trained on a GPU (installed instead of CPU training)
TORCH_INDEX=https://download.pytorch.org/whl/cpu   # CPU PyTorch wheels (small image)

# Fetch missing mission datasets (OPS-SAT, Hubble, Webb - small public sources) automatically when online: on | off
SMC_AUTO_INSTALL=on
# Vercel only: set SMC_MODE=vercel in the Vercel dashboard.
# Leave the default local mode for Docker and scripts/dev.sh.
SMC_MODE=local
# Vercel cache location (ephemeral); SPACEML_STORAGE_DIR remains the local setting.
# STORAGE_DIR=/tmp/smc
SMC_LIVE_MAX_AGE=120
